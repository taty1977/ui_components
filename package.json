{
  "name": "@taty1977/my-component-library",
  "version": "1.0.0",
  "description": "Reusable React UI components for the web",
  "author": "Tatiana Riestra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taty1977/ui_components.git"
  },
  "homepage": "https://github.com/taty1977/ui_components#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind.preset.cjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "tailwind.preset.cjs",
    "tokens/figma/*.json",
    "utils/*.cjs"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm run generate-tokens && vite build && tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "check-package": "npm run build && node scripts/check-package.mjs",
    "validate": "npm run check-tokens && npm run typecheck && npm run lint && npm test && npm run build-storybook && npm run check-package",
    "generate-tokens": "node scripts/generate-tokens.cjs",
    "check-tokens": "node scripts/generate-tokens.cjs --check",
    "typecheck": "tsc --noEmit",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chromatic": "chromatic"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "chromatic": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx}": "eslint --fix",
    "tokens/figma/*.json": "node scripts/generate-tokens.cjs"
  }
}
